  },
  "operations": {
    "retentionClass": "provider-default",
    "dataResidency": [
      "policy-bound"
    ],
    "costControl": "flow-run-budget"
  },
  "licensing": {
    "model": "Open-source/self-hosted core with commercial embedding/enterprise features",
    "redistributionReviewRequired": true,
    "notes": "VAOS uses predefined flows and does not depend on embedded builder capabilities."
  },
  "notes": "Disabled/evaluation-only. Used as a replaceable workflow-orchestration hedge to n8n."
}
