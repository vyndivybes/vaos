    "verificationStrategy": "provider-readback",
    "healthProbe": "required",
    "rollbackMethod": "disable-provider"
  },
  "operations": {
    "retentionClass": "document-policy-bound",
    "dataResidency": [
      "IN",
      "self-hosted-policy-bound"
    ],
    "costControl": "storage-and-ocr-budget"
  },
  "licensing": {
    "model": "Open-source/self-hosted document management",
    "redistributionReviewRequired": true,
    "notes": "API v10 preferred; duplicate-consumption policy and OCR/storage behavior require deployment qualification."
