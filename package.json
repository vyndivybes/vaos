{
  "name": "vaos",
  "private": true,
  "version": "0.0.1",
  "description": "VYNDI Agentic OS monorepo",
  "workspaces": [
    "apps/*",
    "agents/*",
    "platform/*",
    "mcp/*",
    "intelligence/*",
    "digital-thread/*",
    "governance/*",
    "integrations/*",
    "compute/*",
    "packages/*",
    "workflows/*"
  ],
  "scripts": {
    "lint": "node --check apps/web/app.mjs && node --check apps/web/router.mjs",
    "test:web": "node --test apps/web/router.test.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "test": "npm run test:web && npm run verify:web && npm run lint"
  }
}
