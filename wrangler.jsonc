{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaos",
  "main": "./apps/web/cloudflare-entry.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "services": [
    {
      "binding": "VYNDI",
      "service": "vyndios"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://jjzycduoujbmiegqfiud.supabase.co"
  },
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://vaos-preview.invalid"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WINDMILL_ADMISSION",
        "class_name": "WindmillAdmissionCoordinator"
      },
      {
        "name": "ACTIVEPIECES_HANDSHAKE",
        "class_name": "ActivepiecesMcpHandshake"
      }
    ]
  },
  "exports": {
    "WindmillAdmissionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ActivepiecesMcpHandshake": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
